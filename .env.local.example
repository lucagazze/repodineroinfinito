# Copiar a .env.local (local) y cargar las mismas variables en Vercel (Settings > Environment Variables).
# .env.local NUNCA se commitea.
# [OBLIGATORIA] = sin ella la app no arranca o no cobra/entrega. Todo lo demás es opcional.
# `npm run setup` revisa estas variables antes de crear la base.

# ============ Supabase (Project Settings > API) ============
# [OBLIGATORIA] https://<ref>.supabase.co
SUPABASE_URL=
# [OBLIGATORIA] service_role / secret key (solo servidor: nunca en el navegador).
SUPABASE_SERVICE_KEY=
# Publishable/anon key: solo para entrar al panel con Google (Supabase Auth > Providers > Google).
SUPABASE_PUBLISHABLE_KEY=

# ---- Solo para `npm run setup` y supabase/sql.py (no hace falta en Vercel) ----
# Token personal: supabase.com > Account > Access Tokens (sbp_...).
SUPABASE_ACCESS_TOKEN=
# El <ref> del proyecto (lo que va antes de .supabase.co). Si falta, se saca de SUPABASE_URL.
SUPABASE_PROJECT_REF=

# ============ App ============
# [OBLIGATORIA] Dirección pública de la app, sin barra final (https://mi-checkout.vercel.app). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# [OBLIGATORIA] La misma dirección pública (la usan los links de mails, el seguimiento y los informes).
PUBLIC_BASE_URL=
# Subdominio propio del panel (panel.tumarca.com). Vacío = el panel vive en el dominio de Vercel.
PANEL_HOST=
# Slug de la tienda cuyo catálogo se muestra en la raíz de un dominio público. Vacío = la raíz lleva al panel.
PUBLIC_HOME_STORE=
# Dominio viejo que redirige a los checkouts nuevos.
LEGACY_HOST=
# Landings servidas por la app (se leen al compilar, ver next.config.ts):
#   LANDING_DOMAINS="tumarca.com" → <oferta>.tumarca.com/<idioma> sirve public/lp/<oferta>/<idioma>/index.html
#   LANDING_PROXIES="sitio=https://www.tumarca.com" → /l/sitio/<ruta> muestra esa página del sitio
LANDING_DOMAINS=
LANDING_PROXIES=

# ============ Acceso al panel ============
# [OBLIGATORIA] Emails que pueden entrar al panel, separados por coma.
ADMIN_EMAILS=
# [OBLIGATORIA] Contraseña del panel.
ADMIN_PASSWORD=
# [OBLIGATORIA] Texto largo al azar: firma las sesiones del panel y de la biblioteca.
ADMIN_SECRET=
# [OBLIGATORIA] Texto largo al azar: cifra las llaves de Stripe/SMTP guardadas y firma los links de descuento.
# Si se cambia, hay que volver a cargar las llaves de cada tienda.
SECRETS_KEY=
# [OBLIGATORIA] Texto largo al azar: lo manda pg_cron a /api/cron/* (setup lo guarda en la base).
CRON_SECRET=
# Texto al azar para /api/health/* (monitor y smoke test).
HEALTH_SECRET=
# Texto al azar para el smoke test (scripts/smoke.mjs cotiza en modo «dry», sin crear nada en Stripe).
SMOKE_SECRET=

# ============ Stripe ============
# Cada tienda carga su propia llave desde el MCP (connect_stripe) y la app crea su webhook sola.
# Esto es solo el respaldo de una cuenta única / el webhook viejo de /api/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PK=

# ============ Datos legales por defecto (cada tienda puede cargar los suyos) ============
# Razón social, dirección y descriptor de la tarjeta que se muestran en el pie, los mails y el catálogo.
LEGAL_NAME=
LEGAL_ADDRESS=
STATEMENT_NAME=

# ============ Mails ============
# Cada tienda puede tener su casilla SMTP/IMAP (set_store_smtp). Esto es el respaldo si no tiene o falla.
# Al menos una vía de envío es [OBLIGATORIA] para entregar: casilla SMTP de la tienda, POSTMARK_TOKEN o BREVO_API_KEY.
DELIVERY_FROM=
POSTMARK_TOKEN=
POSTMARK_BROADCAST_STREAM=
BREVO_API_KEY=
# Dominio para los links de seguimiento de los mails (aperturas/clics). Vacío = el del checkout.
MAIL_TRACK_BASE=
# Email propio al que van las compras de prueba y las pruebas de email marketing.
TEST_EMAIL=
# Casillas propias (separadas por coma): la IA del buzón no las trata como compradores.
OWN_EMAILS=
# Solo en pruebas: TODOS los mails salen a esta dirección.
MAIL_TEST_ONLY_TO=
# Slugs de tiendas que no suman en ventas/métricas (separados por coma).
EXCLUDED_STORES=

# ============ Meta (opcional: métricas de campañas, Conversions API, piloto de pujas) ============
# Token de usuario del sistema (lectura de anuncios). También se puede cargar desde el panel (Configuración > Meta).
META_TOKEN=
# Token con permiso de edición de anuncios (interruptores, presupuesto y puja desde el panel; piloto de pujas).
META_ADS_TOKEN=
# Token de Conversions API de respaldo (cada píxel puede tener el suyo).
META_CAPI_TOKEN=
# Cuenta publicitaria para los links al Administrador de anuncios (act_123...).
NEXT_PUBLIC_META_AD_ACCOUNT=
# Cuentas que revisa el piloto automático (act_123,act_456).
META_AUTOPILOT_ACCOUNTS=

# ============ IA (opcional: respuestas sugeridas del buzón, Mejoras, email marketing con IA) ============
# Con GEMINI_API_KEY usa Gemini; si no, Anthropic.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Modelo a usar (vacío = el de por defecto de cada proveedor).
AI_MODEL=

# ============ Google Drive (opcional) ============
# Cuenta de servicio editora de la carpeta de entregas (JSON en una línea): revisa preventas, baja PDFs a la biblioteca.
GOOGLE_SA_JSON=
# Carpeta local donde una IA arma los productos en preventa (solo se usa en los prompts que copia el panel).
BOOKS_ROOT=

# ============ Biblioteca de clientes (opcional) ============
# Compradores de prueba para el botón «Portal» del panel: «slug=email,otra=email».
PORTAL_DEMO_EMAILS=
# 1 = loguea los tiempos de armado de la biblioteca.
BIB_TIMING=

# ============ Compras de otras plataformas (opcional: la IA del buzón y la biblioteca las reconocen) ============
# Plataforma anterior: una función RPC de solo lectura en otro Supabase/PostgREST (ver src/lib/legacy-lookup.ts).
LEGACY_LOOKUP_URL=
LEGACY_LOOKUP_ANON=
LEGACY_LOOKUP_KEY=
LEGACY_LOOKUP_RPC=
# Shopify (app de Dev Dashboard con client credentials, permiso read_orders). Ver src/lib/shopify-lookup.ts.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Slugs de las tiendas de la app que se buscan en Shopify (la primera gana si el libro está en varias).
SHOPIFY_LOOKUP_STORES=

# ============ Microsoft Clarity (opcional: mapas de calor en checkout/landings) ============
NEXT_PUBLIC_CLARITY_ID=
# Grabaciones de sesión propias: tope diario en MB (por defecto 250).
REC_DAY_CAP_MB=

# ============ Vercel (opcional: que el panel agregue dominios solo) ============
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ============ Notificaciones push del panel (opcional) ============
# Generar con: npx web-push generate-vapid-keys  (la pública va en las dos variables)
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
# Solo en pruebas: los push van únicamente a este endpoint.
PUSH_TEST_ONLY_ENDPOINT=

# ============ Smoke test y deploy seguro (solo en tu computadora, o en .env.deploy) ============
# Ver scripts/smoke.mjs y scripts/deploy-safe.sh.
SMOKE_APP_BASE=
SMOKE_FUNNELS=
SMOKE_STORE_IDS=
SMOKE_NO_BROWSER=
SMOKE_R=
SMOKE_R_FUNNEL=
PROD_ALIAS=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Las pone Vercel/Node solas (no cargar): NODE_ENV, VERCEL_REGION, VERCEL_GIT_COMMIT_SHA, NEXT_DIST_DIR.

# Microsoft Clarity. Un proyecto por sitio (Clarity mezcla dominios dentro del
# mismo proyecto). Clave = slug de la tienda o dominio:
#   NEXT_PUBLIC_CLARITY_IDS=financestudylab:xxxx,physicstudylab:yyyy
# NEXT_PUBLIC_CLARITY_ID queda como respaldo para un solo sitio.
NEXT_PUBLIC_CLARITY_IDS=
